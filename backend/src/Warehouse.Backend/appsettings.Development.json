{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Warehouse": {
    "MqttHost": "localhost",
    "MqttPort": 1883,
    "AggregationIntervalMinutes": 5,
    "AlertCooldownSeconds": 15,
    "EnergyEuroPerKwh": 0.18,
    "OfflineThresholdSeconds": 10,
    "OfflineScanSeconds": 5,
    "RuleCacheSeconds": 10,
    "TelemetryRetentionDays": 2,
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "WarehouseAuth": {
    "SigningKey": "vrcoresched-demo-signing-key-please-change-in-production-0123456789",
    "Issuer": "vR-CoreSched",
    "Audience": "vR-CoreSched-Web"
  }
}
