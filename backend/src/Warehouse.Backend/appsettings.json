{
  "ConnectionStrings": {
    "WarehouseDb": "Host=localhost;Port=55432;Database=vrcoresched;Username=vruser;Password=vrpassword"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Warehouse": {
    "MqttHost": "localhost",
    "MqttPort": 1883,
    "AggregationIntervalMinutes": 60,
    "AlertCooldownSeconds": 30,
    "EnergyEuroPerKwh": 0.18,
    "OfflineThresholdSeconds": 10,
    "OfflineScanSeconds": 5,
    "RuleCacheSeconds": 30,
    "TelemetryRetentionDays": 7,
    "SnapshotAlertLimit": 100,
    "SnapshotAggregateLimit": 200,
    "SnapshotMaintenanceLimit": 100,
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "WarehouseAuth": {
    "SigningKey": "vrcoresched-demo-signing-key-please-change-in-production-0123456789",
    "Issuer": "vR-CoreSched",
    "Audience": "vR-CoreSched-Web"
  }
}
